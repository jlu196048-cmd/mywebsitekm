<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A minimalist bilingual personal blog.">
  <title>My Website</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
</head>
<body>
  <div id="site-header"></div>

  <main>
    <section class="intro" id="intro-section">
      <h2 class="section-title" data-i18n="home.hello">你好</h2>
      <div id="intro-text"></div>
    </section>

    <section>
      <h2 class="section-title" data-i18n="home.latestPosts">最新文章</h2>
      <div id="latest-posts"></div>
      <p class="view-all"><a href="/blog" data-i18n="home.viewAll">查看所有文章 →</a></p>
    </section>
  </main>

  <div id="site-footer"></div>

  <script src="/js/i18n.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/layout.js"></script>
  <script>
    window.initLayout('home').then(function() {
      const lang = window.getLang();
      window.API.getProfile().then(function(profile) {
        const txt = (profile.intro && profile.intro[lang]) || '';
        document.getElementById('intro-text').innerHTML = '<p>' + window.escapeHTML(txt).replace(/\n/g, '</p><p>') + '</p>';
        // update document title from profile
        document.title = (profile.name || 'My Website');
      }).catch(function() {});
      window.API.getPosts({ limit: 5, status: 'published', sort: 'desc' }).then(function(data) {
        const wrap = document.getElementById('latest-posts');
        if (!data.items || data.items.length === 0) {
          wrap.innerHTML = '<p class="form-msg">' + window.escapeHTML(window.I18N['blog.empty'][lang]) + '</p>';
          return;
        }
        wrap.innerHTML = data.items.map(function(post) {
          const t = post.title || {};
          const sum = post.summary || {};
          const imgTag = post.cover ? '<img class="post-thumb" src="' + post.cover + '" alt="">' : '';
          return `
            <article class="post-entry">
              ${imgTag}
              <h3><a href="/post?id=${post.id}">${window.escapeHTML(t[lang] || t.zh || t.en || '')}</a></h3>
              <div class="post-meta">
                <span>${window.formatDate(post.date)}</span>
                ${post.category ? '<span class="category">' + window.escapeHTML(post.category) + '</span>' : ''}
              </div>
              <div class="post-summary">${window.escapeHTML(sum[lang] || sum.zh || sum.en || '')}</div>
              <a class="read-more" href="/post?id=${post.id}" data-i18n="home.readMore">继续阅读 →</a>
            </article>`;
        }).join('');
        window.applyI18n(lang);
      }).catch(function(e) { console.error(e); });
    });
  </script>
</body>
</html>
