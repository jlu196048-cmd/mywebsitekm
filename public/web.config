<?xml version="1.0" encoding="utf-8"?>
<!--
  mywebsite - IIS configuration (Plan B, v2)
  ===========================================

  This web.config lives at the IIS site root, which we point at public/.
  Resources are referenced relative to public/ now, so /about -> about.html.

  How it works:
    • IIS serves the static frontend (HTML/CSS/JS/images) directly from this dir.
    • Any /api/* request is forwarded via ARR reverse-proxy to a local Node
      process (started by start-mywebsite.cmd / setup-autostart.ps1).
    • /about, /blog, /contact, /post, /admin are rewritten to the matching
      files.
    • Hidden segments hide data/, server/, etc. from the web root, but in
      Plan B the site root is public/, so these segments are not even
      descendants of the site root — they're protected by being above the
      site root entirely.

  Required:
    • Application Request Routing (ARR) with proxy enabled. Run enable-arr.ps1.

  Not required:
    • iisnode
    • URL Rewrite 2.0 schema — IIS' built-in <rewrite> is enough.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear/>
        <add value="index.html"/>
      </files>
    </defaultDocument>

    <!-- Gzip responses -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <dynamicTypes>
        <add mimeType="application/json" enabled="true"/>
        <add mimeType="application/javascript" enabled="true"/>
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/css" enabled="true"/>
        <add mimeType="application/javascript" enabled="true"/>
        <add mimeType="image/svg+xml" enabled="true"/>
      </staticTypes>
    </httpCompression>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00"/>
    </staticContent>

    <!--
      Note about reverse-proxy / ARR:
        - The cleanest way to forward /api/* to the Node backend on port 3001
          is via Application Request Routing (ARR). web.config MUST contain
          <proxy enabled="true"/> for that. But installing ARR is finicky
          on some Windows machines — see enable-arr.ps1.
        - To remain functional even without ARR, the frontend pages include
          <meta name="mywebsite-backend" content="http://127.0.0.1:3001"/>
          and the JS client (public/js/app.js) auto-discovers whether the
          backend is reachable at the same origin OR at that absolute URL,
          falling back transparently.
        - So: leave this web.config ARR-free for now. If you later get
          ARR installed and enabled, you can re-add <proxy enabled="true"/>
          plus a "ProxyApi" rewrite rule and the frontend will keep using
          same-origin (no change needed). The fallback is purely additive.
    -->

    <rewrite>
      <rules>

        <!-- 1. Don't expose Cloudflare-only metadata files -->
        <rule name="BlockCloudflareOnly" enabled="true" stopProcessing="true">
          <match url="^_(redirects|headers)$"/>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found"/>
        </rule>

        <!-- 2. Static files: serve directly -->
        <rule name="StaticFiles" enabled="true" stopProcessing="true">
          <match url=".*"/>
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile"/>
          </conditions>
          <action type="None"/>
        </rule>

        <!-- 3. Pretty URLs: /about -> about.html (same dir as web.config) -->
        <rule name="PrettyUrls" enabled="true" stopProcessing="true">
          <match url="^(about|blog|contact|post)$"/>
          <action type="Rewrite" url="{R:0}.html"/>
        </rule>

        <!-- 4. Admin SPA routing
             /admin           -> admin/login (entry point)
             /admin/dashboard -> admin/dashboard (after login)
             /admin/logout    -> admin/login (with token cleared)
             Anything else under /admin/* stays as-is so static files
             inside admin/ (images, css, etc.) load directly. -->
        <rule name="AdminRoot" enabled="true" stopProcessing="true">
          <match url="^admin/?$"/>
          <action type="Rewrite" url="admin/index.html"/>
        </rule>
        <rule name="AdminDashboard" enabled="true" stopProcessing="true">
          <match url="^admin/dashboard/?$"/>
          <action type="Rewrite" url="admin/dashboard.html"/>
        </rule>

      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="DENY"/>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <location path="admin">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, nofollow"/>
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
